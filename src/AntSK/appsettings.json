{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "urls": "http://*:5000",
  "ProSettings": {
    "NavTheme": "light",
    "Layout": "top",
    "ContentWidth": "Fluid",
    "FixedHeader": false,
    "FixSiderbar": true,
    "Title": "AntSK",
    "PrimaryColor": "daybreak",
    "ColorWeak": false,
    "SplitMenus": false,
    "HeaderRender": true,
    "FooterRender": true,
    "MenuRender": true,
    "MenuHeaderRender": true,
    "HeaderHeight": 48
  },
  "DBConnection": {
    "DbType": "Sqlite",
    "ConnectionStrings": "Data Source=AntSK.db;"
  },
  "KernelMemory": {
    "VectorDb": "Disk",
    "ConnectionString": "Host=;Port=;Database=antsk;Username=;Password=",
    "TableNamePrefix": "km-"
  },
  "FileDir": {
    "DirectoryPath": "D:\\model"
  },
  // ===== 安全加固：登录口令 =====
  // 请在首次启动【之前】设置自己的高强度口令（长度 >= 16 位，含大小写字母、数字与特殊字符）。
  // 生产环境建议改为通过环境变量注入：Login__User / Login__Password。
  // 若此处留空，系统会在首次启动时自动生成一个高强度随机口令，
  // 并输出到启动日志与程序目录下的 antsk-initial-credential.txt。
  // 完整要求见 docs/deploy/security.md
  "Login": {
    "User": "admin",
    "Password": ""
  },
  "BackgroundTaskBroker": {
    "ImportKMSTask": {
      "WorkerCount": 1
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "Endpoint": "http://aspire-dashboard:18889"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "D:\\model\\logs\\log-.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
